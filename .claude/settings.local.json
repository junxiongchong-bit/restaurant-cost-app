{
  "permissions": {
    "allow": [
      "Bash(where node)",
      "Bash(node --version)",
      "Bash(start http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(node server.js)",
      "WebFetch(domain:claude.ai)",
      "mcp__claude_ai_Square__get_service_info",
      "Bash(netstat -ano)",
      "Bash(findstr :3000)",
      "Bash(taskkill /PID 37068 /F)",
      "Bash(cmd /c \"taskkill /PID 37068 /F\")",
      "Bash(cmd /c \"netstat -ano | findstr :3000 | findstr LISTENING\")",
      "Bash(cmd /c \"netstat -ano | findstr :3000\")",
      "Bash(cmd /c \"wmic process where \"\"name=''node.exe''\"\" get ProcessId,CommandLine\")",
      "Bash(cmd /c \"for /f \"\"tokens=5\"\" %a in \\(''netstat -aon ^| findstr :3000 ^| findstr LISTEN''\\) do @echo PID: %a\")"
    ]
  }
}
